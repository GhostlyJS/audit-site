# =====================================================================
# Configuration de l'outil d'audit. Copier ce fichier en « .env » puis
# compléter. Après modification : docker compose up -d
# =====================================================================

# --- Accès ---
# Ports publiés sur le serveur. Sans domaine : http://IP_DU_SERVEUR:8095
HTTP_PORT=8095
HTTPS_PORT=8443
# Nom de domaine (ex. audit.mondomaine.fr). Laisser vide tant qu'il n'y en a pas.
# Une fois renseigné, Caddy active le HTTPS automatiquement : il faut alors que
# HTTP_PORT=80 et HTTPS_PORT=443 (voir README, section « Ajouter un domaine »).
DOMAIN=
# Adresse publique utilisée dans les liens partagés et les emails.
# Vide = déduite du domaine, sinon de l'adresse utilisée par le visiteur.
PUBLIC_URL=

# --- Marque affichée ---
BRAND_NAME=Audit Site Sobre
OWNER_NAME=Votre Nom
OWNER_BIO=Développeur web indépendant, j’aide les PME à avoir des sites rapides, bien référencés et sobres.
# Lien vers votre site (facultatif)
OWNER_URL=

# --- Notification des demandes de contact (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (SSL direct), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur des notifications (par défaut SMTP_USER)
SMTP_FROM=
# Adresse qui reçoit les nouvelles demandes
NOTIFY_EMAIL=

# --- Administration (/admin) ---
ADMIN_USER=admin
# Obligatoire pour accéder à /admin (vide = administration désactivée)
ADMIN_PASSWORD=

# Secret de signature du formulaire (chaîne aléatoire longue).
# Générer avec : openssl rand -hex 32
FORM_SECRET=

# --- File d'analyses ---
# Nombre d'analyses simultanées (Chromium consomme ~0,5–1 Go chacune)
QUEUE_CONCURRENCY=1
# Durée maximale d'une analyse, en secondes
ANALYSIS_TIMEOUT_SECONDS=90
# Nombre maximal d'analyses en attente avant de refuser les nouvelles
QUEUE_MAX=30
# Réutilisation d'un résultat récent pour la même adresse (heures)
CACHE_HOURS=24

# --- Données et limites ---
# Suppression automatique des rapports sans demande de contact (jours)
RETENTION_DAYS=90
# Analyses maximum par heure et par adresse IP
RATE_ANALYSES_PER_HOUR=10
# Envois du formulaire de contact maximum par heure et par adresse IP
RATE_LEADS_PER_HOUR=5
