{
  "name": "audit-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outil gratuit d'audit de site pour patrons de PME",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "lighthouse": "13.5.0",
    "nodemailer": "10.1.0",
    "puppeteer-core": "25.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
